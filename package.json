{
  "name": "telegram-pi",
  "version": "0.0.0",
  "description": "Telegram Gateway and isolated Pi Durable Actors on Agent Substrate",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.8.2 <27"
  },
  "packageManager": "npm@11.19.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/narumiruna/pi-agent-substrate-telegram-example.git"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/gateway/index.js",
    "start:actor": "node dist/actor/index.js",
    "migrate": "node dist/gateway/migrate.js",
    "provision": "node dist/substrate/provision.js",
    "test:postgres": "bash scripts/test-postgres.sh",
    "check:deployment": "bash scripts/check-deployment.sh",
    "typecheck:test": "tsc -p tests/tsconfig.json",
    "check": "biome ci .",
    "test": "vitest run",
    "test:fixtures": "node --test tests/fixtures/check.mjs",
    "generate:substrate": "bash scripts/generate-substrate.sh",
    "ci": "npm run check && npm run typecheck:test && npm test && npm run test:fixtures && npm run build",
    "prepare": "husky"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.0",
    "@grpc/grpc-js": "1.14.7",
    "pg": "8.23.1",
    "undici": "8.12.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "grpc-tools": "1.13.1",
    "husky": "9.1.7",
    "ts-proto": "2.18.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0",
    "yaml": "2.9.1"
  }
}
