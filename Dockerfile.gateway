FROM node:26.12.1-bookworm-slim@sha256:88e480776c6149ff1d098cd304f44bf18057fb5d284a3329b78162d29821e28c AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY tsconfig.json ./
COPY src/gateway ./src/gateway
COPY src/substrate ./src/substrate
COPY src/actor/config.ts src/actor/transport.ts ./src/actor/
RUN ./node_modules/.bin/tsc \
    && test -f dist/gateway/index.js \
    && test -f dist/gateway/migrate.js \
    && test -f dist/substrate/provision.js \
    && npm prune --omit=dev --ignore-scripts

FROM node:26.12.1-bookworm-slim@sha256:88e480776c6149ff1d098cd304f44bf18057fb5d284a3329b78162d29821e28c
WORKDIR /app
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
USER 1000:1000
EXPOSE 8080
CMD ["node", "dist/gateway/index.js"]
